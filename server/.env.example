# MongoDB Connection String (Atlas, or a local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/MCC?retryWrites=true&w=majority

# JWT secrets: long random values, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_value
# Optional; defaults to a value derived from JWT_SECRET
JWT_REFRESH_SECRET=

# Server Port (the web app's NEXT_PUBLIC_API_URL defaults to http://localhost:4000/api)
PORT=4000

# Web app origin(s) for CORS and cookies; comma-separate several
CLIENT_URL=http://localhost:3000

# Web Push VAPID Keys (for Notifications)
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or your site's https URL
VAPID_SUBJECT=

# Cloudinary (signed profile-photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
